{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch Avalonia App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/bin/Debug/net10.0-windows/ManualDoubleSidedPrinter.dll",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Package Installer",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/package-installer.ps1\""
    }
  ]
}
